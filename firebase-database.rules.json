{
  "rules": {
    "profiles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "rooms": {
      ".read": "auth != null",
      "$room": {
        ".write": "auth != null && newData.child('players').child(auth.uid).exists() && newData.child('players').numChildren() <= 8",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid || auth != null && root.child('rooms').child($room).child('host').val() === auth.uid"
          }
        },
        "chat": {
          "$message": {
            ".write": "auth != null && root.child('rooms').child($room).child('players').child(auth.uid).exists()"
          }
        }
      }
    }
  }
}